# Backend local development
SPRING_PROFILES_ACTIVE=dev

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/snkProjet_docker
SPRING_DATASOURCE_USERNAME=myuser
SPRING_DATASOURCE_PASSWORD=replace-with-your-local-db-password

# Auth and URLs
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
APP_FRONTEND_BASE_URL=http://localhost:5173
APP_BACKEND_PUBLIC_BASE_URL=http://localhost:8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/login/oauth2/code/discord

# Optional features
APP_TOKEN_ENCRYPTION_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
